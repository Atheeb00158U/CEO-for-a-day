# Copy to .env.local for `npm run dev`. The same values go in Railway's variables.
# Supabase (Mumbai project): Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google's sign-in button: the same OAuth client ID as in Supabase → Auth → Providers → Google (public, not secret).
# Without it, sign-in falls back to Supabase's Google page.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server only. Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Streak reminders: `node -e 'console.log(require("web-push").generateVAPIDKeys())'`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Shared with Supabase Vault (`cron_secret`) so only pg_cron can trigger reminders.
CRON_SECRET=
# Password for /admin (HTTP Basic Auth).
ADMIN_PASSWORD=
# Razorpay Subscriptions (server only; test keys first). Plans are created in the dashboard; ids are not secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_FOUNDING=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
# Paywall switch: unset = off for everyone except these testers (comma-separated emails); 1 = on for all.
PAYWALL_ON=
PAYWALL_TESTERS=
