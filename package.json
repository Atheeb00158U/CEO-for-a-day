    "hotseat:tree": "node scripts/hotseat.mjs tree",
    "media": "node scripts/media.mjs",
    "narrate": "npm run -s voices && \"${VOICESTUDIO_PYTHON:-$HOME/Library/Application Support/VoiceStudio/runtime/project/.venv/bin/python}\" scripts/narrate.py voice-lines.json public/audio",
