{
  "name": "ceo-for-a-day",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "validate": "vitest run src/content/hotseats.test.ts --silent=false",
    "voices": "node scripts/list-voice-lines.mjs > voice-lines.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "predev": "node scripts/sync-media.mjs",
    "prebuild": "node scripts/sync-media.mjs",
    "hotseat:check": "node scripts/hotseat.mjs check",
    "hotseat:new": "node scripts/hotseat.mjs new",
    "hotseat:tree": "node scripts/hotseat.mjs tree",
    "media": "node scripts/media.mjs",
    "narrate": "npm run -s voices && python3 scripts/narrate.py voice-lines.json public/audio \"$KOKORO_MODEL\" \"$KOKORO_VOICES\""
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "type": "module"
}
